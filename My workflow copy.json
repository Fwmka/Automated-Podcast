        "responses": {
          "values": [
            {
              "content": "=Create a podcast outline about: {{ $('Podcast Input Form').first().json.podcast_topic }}\n\nTarget duration: {{ $('Podcast Input Form').first().json.target_duration_minutes }} minutes\n\nReturn ONLY valid JSON in this exact format (no markdown, no code blocks):\n{\n  \"podcast_title\": \"...\",\n  \"overall_summary\": \"...\",\n  \"topics\": [\n    {\n      \"title\": \"...\",\n      \"summary\": \"...\",\n      \"key_points\": [\"...\", \"...\", \"...\"]\n    }\n  ]\n}\n\nCreate 3-5 topics with engaging content suitable for a {{ $('Podcast Input Form').first().json.target_duration_minutes }}-minute podcast."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "101b19a3-c790-49fc-8d7b-b8a063976ac6",
      "name": "Generate Outline",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [
        -640,
        128
      ],
